[Unit]
Description=Storage Report HTTP Server (Hermes 2FA Theme)
After=network.target

[Service]
Type=simple
ExecStart=%h/.hermes/hermes-agent/venv/bin/storage-report-serve
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.hermes/hermes-agent/venv/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
